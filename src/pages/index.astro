		<script is:inline define:vars={{ translationsJson }}>
			const translations = JSON.parse(translationsJson);
			const titleElement = document.querySelector('title');
			const descriptionElement = document.querySelector('meta[name="description"]');
			const buttons = Array.from(document.querySelectorAll('[data-lang-toggle]'));

			const getValue = (source, path) =>
				path.split('.').reduce((value, key) => {
					if (value === undefined || value === null) return undefined;
					if (/^\d+$/.test(key)) return value[Number(key)];
					return value[key];
				}, source);

			const applyLanguage = (lang) => {
				const copy = translations[lang] ?? translations.en;

				document.documentElement.lang = copy.lang;
				if (titleElement) titleElement.textContent = copy.title;
				if (descriptionElement) descriptionElement.setAttribute('content', copy.metaDescription);

				document.querySelectorAll('[data-i18n]').forEach((element) => {
					const path = element.getAttribute('data-i18n');
					if (!path) return;
					const value = getValue(copy, path);
					if (typeof value === 'string') element.textContent = value;
				});

				buttons.forEach((button) => {
					const isActive = button.getAttribute('data-lang-toggle') === lang;
					button.classList.toggle('is-active', isActive);
					button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
				});

				localStorage.setItem('nexa-lang', lang);
			};

			const savedLanguage = localStorage.getItem('nexa-lang');
			const browserLanguage = navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
			const initialLanguage = savedLanguage === 'es' || savedLanguage === 'en' ? savedLanguage : browserLanguage;

			applyLanguage(initialLanguage);

			buttons.forEach((button) => {
				button.addEventListener('click', () => {
					const lang = button.getAttribute('data-lang-toggle');
					if (lang === 'en' || lang === 'es') applyLanguage(lang);
				});
			});
		</script>
		<LandingEffects client:idle />
