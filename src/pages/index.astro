const translationsJson = JSON.stringify(translations);
---

<html lang={copy.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={copy.metaDescription} />
		<title>{copy.title}</title>
		{import.meta.env.DEV ? (
			<script is:inline>
				const originalWarn = console.warn.bind(console);
				console.warn = (...args) => {
					const first = typeof args[0] === 'string' ? args[0] : '';
					if (first.includes('THREE.THREE.Clock: This module has been deprecated')) return;
					if (first.includes('not eligible for reset')) return;
					originalWarn(...args);
				};
			</script>
		) : null}
	</head>
	<body>
		<div class="site-shell">
			<div class="ambient ambient-left"></div>
			<div class="ambient ambient-right"></div>
			<div class="grid-overlay"></div>
			<svg class="section-connections" viewBox="0 0 1000 2200" preserveAspectRatio="none" aria-hidden="true">
				<path class="section-connector-path" d="M640 240 C840 360, 220 520, 520 700" />
				<path class="section-connector-path" d="M520 700 C760 900, 360 1080, 620 1280" />
				<path class="section-connector-path" d="M620 1280 C860 1460, 260 1640, 560 1840" />
			</svg>
			<header class="topbar">
				<div class="topbar-shell">
					<a class="brand brand-topbar" href="#hero">
						<span class="brand-mark">N</span>
						<span class="brand-copy">
							<strong>NEXA</strong>
							<span class="brand-meta">
								<span data-i18n="hero.eyebrow">{copy.hero.eyebrow}</span>
								<span class="brand-meta-separator" aria-hidden="true"></span>
								<span class="brand-live">
									<span class="status-dot"></span>
									<span data-i18n="nav.statusShort">{copy.nav.statusShort}</span>
								</span>
							</span>
						</span>
					</a>
					<div class="topbar-middle">
						<nav class="nav nav-topbar">
							<a href="#platform">
								<span class="nav-index">01</span>
								<span data-i18n="nav.solutions">{copy.nav.solutions}</span>
							</a>
							<a href="#use-cases">
								<span class="nav-index">02</span>
								<span data-i18n="nav.useCases">{copy.nav.useCases}</span>
							</a>
							<a href="#pricing">
								<span class="nav-index">03</span>
								<span data-i18n="nav.engagements">{copy.nav.engagements}</span>
							</a>
						</nav>
					</div>
					<div class="topbar-actions">
						<div class="lang-switch" aria-label="Language switch">
							<button class="lang-button is-active" data-lang-toggle="en" type="button">EN</button>
							<button class="lang-button" data-lang-toggle="es" type="button">ES</button>
						</div>
						<a class="button button-primary button-sm button-nav" href="mailto:hello@nexa.app?subject=Strategy%20call" data-i18n="nav.bookCall">
							{copy.nav.bookCall}
						</a>
					</div>
				</div>
			</header>

			<main>
				<section class="hero" id="hero" data-flow-section="hero">
					<div class="hero-backdrop" aria-hidden="true">
						<span class="hero-backdrop-orb hero-backdrop-orb-a" data-hero-ambient></span>
						<span class="hero-backdrop-orb hero-backdrop-orb-b" data-hero-ambient></span>
						<span class="hero-backdrop-line hero-backdrop-line-a" data-hero-ambient></span>
						<span class="hero-backdrop-line hero-backdrop-line-b" data-hero-ambient></span>
					</div>
					<div class="hero-copy" data-reveal>
						<div class="hero-copy-rings" aria-hidden="true">
							<span class="hero-copy-ring hero-copy-ring-a" data-hero-copy-decor></span>
							<span class="hero-copy-ring hero-copy-ring-b" data-hero-copy-decor></span>
							<span class="hero-copy-ring hero-copy-ring-c" data-hero-copy-decor></span>
						</div>
						<div class="eyebrow" data-hero-eyebrow>
							<span class="status-dot"></span>
							<span data-i18n="hero.eyebrow">{copy.hero.eyebrow}</span>
						</div>
						<h1 data-hero-title data-i18n="hero.title">{copy.hero.title}</h1>
						<p class="hero-text" data-hero-text data-i18n="hero.text">{copy.hero.text}</p>
						<div class="hero-actions" data-hero-actions>
							<a class="button button-primary" href="mailto:hello@nexa.app?subject=Strategy%20call" data-i18n="hero.primaryCta">
								{copy.hero.primaryCta}
							</a>
							<a class="button button-secondary" href="#platform" data-i18n="hero.secondaryCta">
								{copy.hero.secondaryCta}
							</a>
						</div>
						<div class="hero-proof" data-hero-proof>
							{copy.hero.proof.map((item, index) => (
								<div class="hero-proof-card" data-hero-proof-card>
									<strong>{item.value}</strong>
									<span data-i18n={`hero.proof.${index}.label`}>{item.label}</span>
								</div>
							))}
						</div>
						<div class="hero-scroll-cue" data-hero-scroll-cue>
							<span class="hero-scroll-cue-mark">
								<span class="hero-scroll-cue-dot"></span>
							</span>
							<span data-i18n="hero.scrollCue">{copy.hero.scrollCue}</span>
						</div>
					</div>

					<HeroExperience integrations={copy.integrations} client:media="(min-width: 960px)" />
				</section>

				<section class="logo-strip" data-reveal>
					<p class="logo-strip-label" data-i18n="logoStrip">{copy.logoStrip}</p>
					<div class="logo-row">
						{copy.integrations.map((integration) => <span>{integration}</span>)}
					</div>
				</section>

				<section class="platform" id="platform" data-flow-section="platform">
					<SectionExperience variant="platform" client:media="(min-width: 960px)" />
					<div class="section-heading" data-reveal>
						<span class="section-kicker" data-i18n="platform.kicker">{copy.platform.kicker}</span>
						<h2 data-i18n="platform.title">{copy.platform.title}</h2>
						<p data-i18n="platform.text">{copy.platform.text}</p>
					</div>

					<div class="feature-grid feature-grid-four">
						{copy.platform.pillars.map((pillar, index) => (
							<article class="feature-card glass-card" data-reveal>
								<div class="feature-icon"></div>
								<h3 data-i18n={`platform.pillars.${index}.title`}>{pillar.title}</h3>
								<p data-i18n={`platform.pillars.${index}.description`}>{pillar.description}</p>
								{index === 0 ? (
									<div class="live-metric">
										<span>Lead scoring accuracy</span>
										<strong data-live-counter="91">91%</strong>
									</div>
								) : null}
								{index === 1 ? (
									<div class="live-bars" aria-hidden="true">
										<span></span>
										<span></span>
										<span></span>
										<span></span>
									</div>
								) : null}
							</article>
						))}
					</div>
				</section>

				<section class="story-stage" data-flow-section="workflow">
					<SectionExperience variant="story" client:visible />
					<div class="story-grid">
						<article class="story-card story-large glass-card" data-reveal>
							<div class="card-tag" data-i18n="story.cards.0.tag">{copy.story.cards[0].tag}</div>
							<h3 data-i18n="story.cards.0.title">{copy.story.cards[0].title}</h3>
							<p data-i18n="story.cards.0.text">{copy.story.cards[0].text}</p>
							<div class="story-flow">
								{copy.story.cards[0].nodes.map((node, index) => (
									<div class:list={['story-node', index === 1 && 'active', index === 3 && 'success']} data-i18n={`story.cards.0.nodes.${index}`}>
										{node}
									</div>
								))}
							</div>
						</article>

						<article class="story-card glass-card" data-reveal>
							<div class="card-tag" data-i18n="story.cards.1.tag">{copy.story.cards[1].tag}</div>
							<h3 data-i18n="story.cards.1.title">{copy.story.cards[1].title}</h3>
							<div class="insight-lines">
								<span></span>
								<span></span>
								<span></span>
								<span></span>
							</div>
							<ul class="signal-list">
								{copy.story.cards[1].signals.map((signal, index) => (
									<li data-i18n={`story.cards.1.signals.${index}`}>{signal}</li>
								))}
							</ul>
						</article>

						<article class="story-card glass-card" data-reveal>
							<div class="card-tag" data-i18n="story.cards.2.tag">{copy.story.cards[2].tag}</div>
							<h3 data-i18n="story.cards.2.title">{copy.story.cards[2].title}</h3>
							<div class="agent-stack">
								{copy.story.cards[2].agents.map((agent, index) => (
									<span data-i18n={`story.cards.2.agents.${index}`}>{agent}</span>
								))}
							</div>
						</article>
					</div>
				</section>

				<section class="how-it-works">
					<div class="section-heading" data-reveal>
						<span class="section-kicker" data-i18n="how.kicker">{copy.how.kicker}</span>
						<h2 data-i18n="how.title">{copy.how.title}</h2>
					</div>
					<div class="steps">
						{copy.how.steps.map((step, index) => (
							<article class="step-card glass-card" data-reveal>
								<span class="step-index">{step.index}</span>
								<h3 data-i18n={`how.steps.${index}.title`}>{step.title}</h3>
								<p data-i18n={`how.steps.${index}.description`}>{step.description}</p>
							</article>
						))}
					</div>
				</section>

				<section class="use-cases" id="use-cases" data-flow-section="use-cases">
					<div class="section-heading" data-reveal>
						<span class="section-kicker" data-i18n="useCases.kicker">{copy.useCases.kicker}</span>
						<h2 data-i18n="useCases.title">{copy.useCases.title}</h2>
					</div>
					<div class="bento-grid">
						<article class="bento-card bento-feature glass-card" data-reveal>
							<div class="card-tag" data-i18n="useCases.cards.0.tag">{copy.useCases.cards[0].tag}</div>
							<h3 data-i18n="useCases.cards.0.title">{copy.useCases.cards[0].title}</h3>
						</article>
						<article class="bento-card glass-card" data-reveal>
							<div class="card-tag" data-i18n="useCases.cards.1.tag">{copy.useCases.cards[1].tag}</div>
							<h3 data-i18n="useCases.cards.1.title">{copy.useCases.cards[1].title}</h3>
						</article>
						<article class="bento-card glass-card" data-reveal>
							<div class="card-tag" data-i18n="useCases.cards.2.tag">{copy.useCases.cards[2].tag}</div>
							<h3 data-i18n="useCases.cards.2.title">{copy.useCases.cards[2].title}</h3>
						</article>
						<article class="bento-card bento-list glass-card" data-reveal>
							<div class="card-tag" data-i18n="useCases.listTag">{copy.useCases.listTag}</div>
							<ul>
								{copy.useCases.list.map((useCase, index) => (
									<li data-i18n={`useCases.list.${index}`}>{useCase}</li>
								))}
							</ul>
						</article>
					</div>
				</section>

				<section class="pricing" id="pricing" data-flow-section="pricing">
					<div class="section-heading" data-reveal>
						<span class="section-kicker" data-i18n="pricing.kicker">{copy.pricing.kicker}</span>
						<h2 data-i18n="pricing.title">{copy.pricing.title}</h2>
					</div>
					<div class="pricing-grid">
						{copy.pricing.plans.map((plan, index) => (
							<article class:list={['pricing-card', 'glass-card', index === 1 && 'featured']} data-reveal>
								<div class="pricing-head">
									<div>
										<span class="card-tag" data-i18n={`pricing.plans.${index}.name`}>{plan.name}</span>
										<h3 class="pricing-title" data-i18n={`pricing.plans.${index}.price`}>{plan.price}</h3>
									</div>
								</div>
								<p data-i18n={`pricing.plans.${index}.description`}>{plan.description}</p>
								<ul>
									{plan.features.map((feature, featureIndex) => (
										<li data-i18n={`pricing.plans.${index}.features.${featureIndex}`}>{feature}</li>
									))}
								</ul>
								<a class:list={['button', index === 1 ? 'button-primary' : 'button-secondary']} href="mailto:hello@nexa.app?subject=Strategy%20call" data-i18n="pricing.cta">
									{copy.pricing.cta}
								</a>
							</article>
						))}
					</div>
				</section>

				<section class="final-cta glass-card" id="final-cta" data-reveal data-flow-section="final">
					<SectionExperience variant="cta" client:visible />
					<div>
						<span class="section-kicker" data-i18n="final.kicker">{copy.final.kicker}</span>
						<h2 data-i18n="final.title">{copy.final.title}</h2>
						<p data-i18n="final.text">{copy.final.text}</p>
					</div>
					<div class="hero-actions">
						<a class="button button-primary" href="mailto:hello@nexa.app?subject=Strategy%20call" data-i18n="final.primary">
							{copy.final.primary}
						</a>
						<a class="button button-secondary" href="mailto:hello@nexa.app?subject=AI%20Audit%20request" data-i18n="final.secondary">
							{copy.final.secondary}
						</a>
					</div>
				</section>
			</main>

			<footer class="footer">
				<a class="brand" href="#hero">
					<span class="brand-mark">N</span>
					<span>NEXA</span>
				</a>
				<p data-i18n="footer.text">{copy.footer.text}</p>
			</footer>
		</div>
		<script is:inline define:vars={{ translationsJson }}>
			const translations = JSON.parse(translationsJson);
			const titleElement = document.querySelector('title');
			const descriptionElement = document.querySelector('meta[name="description"]');
			const buttons = Array.from(document.querySelectorAll('[data-lang-toggle]'));

			const getValue = (source, path) =>
				path.split('.').reduce((value, key) => {
					if (value === undefined || value === null) return undefined;
					if (/^\d+$/.test(key)) return value[Number(key)];
					return value[key];
				}, source);

			const applyLanguage = (lang) => {
				const copy = translations[lang] ?? translations.en;

				document.documentElement.lang = copy.lang;
				if (titleElement) titleElement.textContent = copy.title;
				if (descriptionElement) descriptionElement.setAttribute('content', copy.metaDescription);

				document.querySelectorAll('[data-i18n]').forEach((element) => {
					const path = element.getAttribute('data-i18n');
					if (!path) return;
					const value = getValue(copy, path);
					if (typeof value === 'string') element.textContent = value;
				});

				buttons.forEach((button) => {
					const isActive = button.getAttribute('data-lang-toggle') === lang;
					button.classList.toggle('is-active', isActive);
					button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
				});

				localStorage.setItem('nexa-lang', lang);
			};

			const savedLanguage = localStorage.getItem('nexa-lang');
			const browserLanguage = navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
			const initialLanguage = savedLanguage === 'es' || savedLanguage === 'en' ? savedLanguage : browserLanguage;

			applyLanguage(initialLanguage);

			buttons.forEach((button) => {
				button.addEventListener('click', () => {
					const lang = button.getAttribute('data-lang-toggle');
					if (lang === 'en' || lang === 'es') applyLanguage(lang);
				});
			});
		</script>
		<LandingEffects client:idle />
	</body>
</html>
